# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
subscription_id = "00000000-0000-0000-0000-000000000000"

# Your own IP, so the Postgres firewall lets the ingest and seed scripts in
# from a laptop. The containers reach it over the VNet, not this rule.
# dev_client_ip = "203.0.113.4"

# Optional overrides:
# location            = "eastus2"
# name_prefix         = "supportagent-hk"
# resource_group_name = "rg-support-agent"
