#
# Copy to .env and fill in. Never commit .env - it holds the database password.
# In deployment these are supplied by Terraform as Container Apps env vars and
# secrets; nothing here is baked into an image.
#

# ------------------------------------------------------------------ database --
# postgresql:// is rewritten to postgresql+psycopg:// automatically.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/support_agent?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# -------------------------------------------------------------- Azure OpenAI --
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-chat
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Deployment authenticates with a user-assigned managed identity; this selects
# which one. Leave unset locally, where developer credentials are used.
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Local development fallback ONLY. Leave unset in deployment: a key in app
# config defeats the managed-identity design.
# AZURE_OPENAI_API_KEY=

# ----------------------------------------------------------------- retrieval --
# Minimum COSINE SIMILARITY (1 - cosine_distance) for a GROUNDED decision.
# Higher is stricter. Calibrated against fixtures/eval - see README.
# Calibrated 2026-11-19 on fixtures/eval (30 labelled queries). On the tuning
# subset this threshold accepts 94% of supported queries and rejects 100% of
# out-of-scope ones; over the full set, the authoritative document is in the
# retrieved evidence 21/21 times. See the README for the whole table.
GROUNDING_THRESHOLD=0.38
# Band below the threshold treated as WEAK (clarify) not UNSUPPORTED (escalate).
GROUNDING_WEAK_MARGIN=0.08
RETRIEVAL_TOP_K=5
CHUNK_TARGET_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
EMBEDDING_DIMENSIONS=1536

# -------------------------------------------------------------------- limits --
MAX_TOOL_CALLS_PER_TURN=5
TURN_BUDGET_S=30
TOOL_TIMEOUT_S=8
LLM_TIMEOUT_S=20
MAX_REQUEST_BYTES=32768
MAX_VOICE_SESSION_S=300
RATE_LIMIT_TURNS_PER_MINUTE_PER_SESSION=12
RATE_LIMIT_TURNS_PER_MINUTE_PER_IP=30
MAX_CONCURRENT_TURNS=8

# ------------------------------------------------------------------ sessions --
SESSION_TTL_S=14400
# JSON array. Empty allows same-origin only, which is the deployed setup.
ALLOWED_ORIGINS=[]

# ---------------------------------------------------------------------- cost --
# Rates are configuration, not provider-reported. The drawer labels every
# figure an estimate and shows this date.
COST_RATES_EFFECTIVE=2026-11-19
COST_PER_1K_INPUT_TOKENS_USD=0.00040
COST_PER_1K_OUTPUT_TOKENS_USD=0.00160
COST_PER_1K_EMBEDDING_TOKENS_USD=0.00002
COST_REALTIME_PER_MINUTE_USD=0.00

# ---------------------------------------------------------------------- demo --
# Enables the fixture reset and fault-injection endpoints. Both are scoped to
# the caller's own session.
DEMO_MODE=true
# Set in the container, where only apps/api is copied. Auto-located otherwise.
# FIXTURES_DIR=/app/fixtures
